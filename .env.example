# Copy to .env.  install.sh creates this safely when it is absent.
COMPOSE_PROJECT_NAME=logging-platform
PLATFORM_DIR=/opt/logging-platform
DATA_DIR=/opt/logging-data
# Eastern Time with automatic EST/EDT daylight-saving transitions.
PLATFORM_TIMEZONE=America/Toronto

# Immutable multi-architecture manifests resolved from current official stable
# releases on 2026-08-25. Runtime Compose never uses a mutable tag.
OPENOBSERVE_IMAGE=public.ecr.aws/zinclabs/openobserve@sha256:88fb692ac791d3eaff69653a4a4686f1c7eceb9e105491d58d29ac2739560b3b
SYSLOG_NG_IMAGE=balabit/syslog-ng@sha256:8f6fe389151c2dfd4c21a2f82ef80ee17cdc71e7c023c813f3974f4d8575b8c5
REPORT_SERVER_IMAGE=public.ecr.aws/zinclabs/report-server@sha256:1e0534b3fdaaeaba641afa0750a2baacede35520312f782631baf7ccd247be17

# `auto` makes update.sh discover official stable releases (never prereleases)
# and resolve a fresh immutable digest. Set an explicit image:tag to hold a
# component on an approved version. docker-compose.yml consumes only pins above.
OPENOBSERVE_STABLE_SOURCE=auto
SYSLOG_NG_STABLE_SOURCE=auto
REPORT_SERVER_STABLE_SOURCE=auto

ZO_ROOT_USER_EMAIL=admin@example.invalid
ZO_ROOT_USER_PASSWORD=CHANGE_ME
ZO_ORG=default
ZO_COMPACT_DATA_RETENTION_DAYS=30
# Current OpenObserve stable enables HTTP/2 streaming search by default.
ZO_STREAMING_ENABLED=true

# OpenObserve is HTTP by default. Place a reverse proxy in front for browser HTTPS.
OPENOBSERVE_HOST_PORT=5080
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514
SYSLOG_TLS_PORT=6514
ENABLE_SYSLOG_TLS=false

# syslog-ng durable queue capacity *per stream*. With the eight supplied
# destinations and prealloc(yes), the default reserves 8 GiB on DATA_DIR.
SYSLOG_DISK_BUFFER_BYTES_PER_STREAM=1073741824
SYSLOG_BATCH_LINES=200
SYSLOG_BATCH_BYTES=1048576
SYSLOG_BATCH_TIMEOUT_MS=1000

# Set true only after reviewing report-server requirements and SMTP settings.
COMPOSE_PROFILES=
ZO_WEB_URL=http://YOUR_SERVER_ADDRESS:5080
ZO_REPORT_SERVER_URL=http://report-server:5090
# ZO_SMTP_HOST=smtp.example.com
# ZO_SMTP_PORT=587
# ZO_SMTP_USER_NAME=reporter@example.com
# ZO_SMTP_PASSWORD=CHANGE_ME
# ZO_SMTP_FROM_EMAIL=reporter@example.com
# ZO_SMTP_ENCRYPTION=starttls

# Optional existing OpenObserve alert destination name. Alert provisioning is
# skipped when blank because OpenObserve requires a destination or workflow.
UNCLASSIFIED_ALERT_DESTINATION=
